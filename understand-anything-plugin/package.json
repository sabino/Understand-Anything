{
  "name": "@understand-anything/skill",
  "version": "2.9.7",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "packageManager": "bun@1.4.2",
  "workspaces": ["packages/*"],
  "trustedDependencies": [],
  "scripts": {
    "build": "bun run --bun --filter @understand-anything/core build && bun run --bun build:skill",
    "build:skill": "tsc",
    "build:dashboard": "bun run --bun --filter @understand-anything/dashboard build",
    "dev:dashboard": "bun run --bun --filter @understand-anything/dashboard dev",
    "test": "bun run --bun --filter @understand-anything/core test"
  },
  "dependencies": {
    "@understand-anything/core": "workspace:*",
    "graphology": "~0.26.0",
    "graphology-communities-louvain": "^2.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
